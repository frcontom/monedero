# Copiar a .env.local con valores reales. NUNCA versionar .env*.
# Server-only:
DATABASE_URL=postgresql://USER:PASS@host/db?sslmode=require
AUTH_SECRET=generar_con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Public:
CURRENCY_CODE=COP
LOCALE=es-CO# Public (cliente):
NEXT_PUBLIC_CURRENCY=COP
NEXT_PUBLIC_LOCALE=es-CO
