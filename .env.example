# Copiar a .env.local con valores reales. NUNCA versionar .env*.
# Server-only:
DATABASE_URL=postgresql://USER:PASS@host/db?sslmode=require
AUTH_SECRET=generar_con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_TRUST_HOST=true
# En Vercel añadir también: AUTH_URL=https://tu-dominio.vercel.app
# Public (se inyectan en el cliente; sin valor usa es-CO / COP):
NEXT_PUBLIC_CURRENCY=COP
NEXT_PUBLIC_LOCALE=es-CO